{
  "name": "counselflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm run contracts:test && npm run build",
    "contracts:build": "tsc -p packages/contracts/tsconfig.json",
    "contracts:test": "npm run contracts:build && node --test packages/contracts/test/*.test.mjs",
    "contracts:typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
